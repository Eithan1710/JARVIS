# ── Database ─────────────────────────────────────────────────────────────
# Supabase → Connect → "Transaction pooler" connection string (port 6543).
# Leave empty for local development: an embedded Postgres (PGlite) is used automatically.
# Tables live in the `jarvis` schema and are created automatically on first start.
DATABASE_URL=

# ── Access ───────────────────────────────────────────────────────────────
APP_PASSCODE=                 # the code that unlocks JARVIS (required in production)
SESSION_SECRET=               # openssl rand -base64 32
ENCRYPTION_KEY=               # openssl rand -base64 32 (encrypts connection tokens)
CRON_SECRET=                  # openssl rand -hex 24 (protects /api/cron/tick)
DEFAULT_TIMEZONE=Asia/Jerusalem

# ── AI (all free tiers; any subset works, JARVIS fails over between them) ─
# Leader. Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fast workers + voice transcription. Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=
# Deep workers. Free "Experiment" plan, phone verification, no card: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Optional model overrides
# GEMINI_MODEL_LEADER=gemini-3.8-flash
# GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
# GROQ_MODEL_LARGE=openai/gpt-oss-120b
# GROQ_MODEL_SMALL=openai/gpt-oss-20b
# MISTRAL_MODEL_LARGE=mistral-large-latest
# Optional 4th provider — any OpenAI-compatible API (e.g. Cloudflare Workers AI, free 10K neurons/day):
# EXTRA_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# EXTRA_AI_API_KEY=
# EXTRA_AI_MODEL=@cf/openai/gpt-oss-120b
# EXTRA_AI_LABEL=Cloudflare

# ── Tools (optional) ─────────────────────────────────────────────────────
TAVILY_API_KEY=               # web search, 1,000 free credits/month, no card: https://app.tavily.com
GITHUB_TOKEN=                 # read-only fine-grained token → private repos (public work without it)

# ── Web push (free) ──────────────────────────────────────────────────────
# Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
