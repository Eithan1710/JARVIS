# ── Database ─────────────────────────────────────────────────────────────
# Supabase → Project settings → Database → Connection string → "Transaction pooler" (port 6543).
# Leave empty for local development: an embedded Postgres (PGlite) is used automatically.
DATABASE_URL=

# ── Access ───────────────────────────────────────────────────────────────
# The passcode that unlocks the app (required in production).
APP_PASSCODE=
# Long random strings. Generate with: openssl rand -base64 32
SESSION_SECRET=
ENCRYPTION_KEY=
# Protects /api/cron/tick (used by the scheduler).
CRON_SECRET=

# ── AI (free) ────────────────────────────────────────────────────────────
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL_FAST=gemini-3.1-flash-lite
# GEMINI_MODEL_BALANCED=gemini-3.8-flash
# GEMINI_MODEL_DEEP=gemini-3.8-flash
# Optional free fallback: https://console.groq.com/keys
GROQ_API_KEY=
# Optional (paid): Anthropic Claude
ANTHROPIC_API_KEY=
AI_PROVIDER_ORDER=gemini,groq,openrouter,anthropic

# ── Web push (free) ──────────────────────────────────────────────────────
# Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
